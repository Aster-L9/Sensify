# Copy to backend/.env and supply your own secrets. Never commit .env.
DATABASE_URL=sqlite:///../database/dummy.db

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Used only when creating accounts in an empty local database.
ADMIN_EMAIL=admin@sensify.local
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ANALYST_PASSWORD=
